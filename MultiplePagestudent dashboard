import { useState } from "react";

function App() {
  const [page, setPage] = useState("home");

  const renderPage = () => {
    if (page === "home") return <Home />;
    if (page === "profile") return <Profile />;
    if (page === "courses") return <Courses />;
  };

  return (
    <div style={styles.container}>
      <h2>🎓 Student Dashboard</h2>

      <div style={styles.nav}>
        <button onClick={() => setPage("home")} style={styles.button}>
          Home
        </button>
        <button onClick={() => setPage("profile")} style={styles.button}>
          Profile
        </button>
        <button onClick={() => setPage("courses")} style={styles.button}>
          Courses
        </button>
      </div>

      <div style={styles.content}>{renderPage()}</div>
    </div>
  );
}

function Home() {
  return <h3>🏠 Welcome to Student Home Page</h3>;
}

function Profile() {
  return (
    <>
      <h3>👤 Student Profile</h3>
      <p>Name: Ravi</p>
      <p>Department: CSE</p>
      <p>Year: 3rd</p>
    </>
  );
}

function Courses() {
  return (
    <>
      <h3>📚 Enrolled Courses</h3>
      <ul>
        <li>Data Structures</li>
        <li>Web Development</li>
        <li>Machine Learning</li>
      </ul>
    </>
  );
}

const styles = {
  container: {
    textAlign: "center",
    fontFamily: "Segoe UI",
    marginTop: "40px",
  },
  nav: {
    marginBottom: "20px",
  },
  button: {
    margin: "0 8px",
    padding: "10px 18px",
    backgroundColor: "#3f51b5",
    color: "white",
    border: "none",
    borderRadius: "5px",
    cursor: "pointer",
  },
  content: {
    marginTop: "20px",
    padding: "15px",
    border: "1px solid #ccc",
    borderRadius: "8px",
    width: "60%",
    margin: "auto",
  },
};

export default App;
