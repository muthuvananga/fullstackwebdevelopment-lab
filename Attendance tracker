import { useState } from "react";

function App() {
  const [students, setStudents] = useState([
    { name: "Anu", status: "Not Marked" },
    { name: "Bala", status: "Not Marked" },
    { name: "Charan", status: "Not Marked" },
    { name: "Divya", status: "Not Marked" },
  ]);

  const markAttendance = (index, status) => {
    const updated = [...students];
    updated[index].status = status;
    setStudents(updated);

    alert(`${updated[index].name} marked as ${status}`);
  };

  return (
    <div style={styles.container}>
      <h2>📋 Student Attendance Tracker</h2>
      <p>Mark attendance dynamically</p>

      <div style={styles.card}>
        {students.map((student, index) => (
          <div key={index} style={styles.row}>
            <span style={styles.name}>{student.name}</span>

            <button
              style={styles.presentBtn}
              onClick={() => markAttendance(index, "Present")}
            >
              Present
            </button>

            <button
              style={styles.absentBtn}
              onClick={() => markAttendance(index, "Absent")}
            >
              Absent
            </button>

            <span
              style={{
                ...styles.status,
                color:
                  student.status === "Present"
                    ? "green"
                    : student.status === "Absent"
                    ? "red"
                    : "gray",
              }}
            >
              {student.status}
            </span>
          </div>
        ))}
      </div>
    </div>
  );
}

const styles = {
  container: {
    textAlign: "center",
    fontFamily: "Segoe UI",
    marginTop: "40px",
  },
  card: {
    width: "420px",
    margin: "auto",
    padding: "20px",
    borderRadius: "10px",
    boxShadow: "0 4px 12px rgba(0,0,0,0.2)",
