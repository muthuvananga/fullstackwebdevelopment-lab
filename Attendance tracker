    justifyContent: "space-between",
    marginBottom: "12px",
  },
  name: {
    fontWeight: "bold",
    width: "80px",
  },
  presentBtn: {
    backgroundColor: "#28a745",
    color: "white",
    border: "none",
    padding: "6px 10px",
    borderRadius: "5px",
    cursor: "pointer",
  },
  absentBtn: {
    backgroundColor: "#dc3545",
    color: "white",
    border: "none",
    padding: "6px 10px",
    borderRadius: "5px",
    cursor: "pointer",
  },
  status: {
    width: "100px",
    fontWeight: "bold",
    textAlign: "right",
  },
};

export default App;

