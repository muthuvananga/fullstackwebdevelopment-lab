import { useState } from "react";

function App() {
  const [comment, setComment] = useState("");
  const [commentsList, setCommentsList] = useState([]);

  const addComment = () => {
    if (!comment.trim()) return alert("Comment cannot be empty!");
    setCommentsList([...commentsList, comment]);
    setComment("");
  };

  return (
    <div style={styles.container}>
      <h2>📰 Blog Post</h2>

      <textarea
        style={styles.textarea}
        placeholder="Write a comment..."
        value={comment}
        onChange={(e) => setComment(e.target.value)}
      />
      <button style={styles.button} onClick={addComment}>Post Comment</button>

      <h3>Comments:</h3>
      <ul>
        {commentsList.map((c, i) => <li key={i}>{c}</li>)}
      </ul>
    </div>
  );
}

const styles = {
  container: { textAlign: "center", fontFamily: "Segoe UI", marginTop: "40px" },
  textarea: { width: "90%", padding: "8px", borderRadius: "5px", border: "1px solid #ccc", height: "60px" },
  button: { marginTop: "10px", padding: "8px 18px", backgroundColor: "#009688", color: "white", border: "none", borderRadius: "5px", cursor: "pointer" },
};

export default App;
