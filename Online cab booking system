function App() {
  const bookCab = () => {
    const passengerName = prompt("Enter Passenger Name:");
    if (!passengerName) {
      alert("Booking cancelled! Passenger name is required.");
      return;
    }

    const pickup = prompt("Enter Pickup Location:");
    if (!pickup) {
      alert("Pickup location is required!");
      return;
    }

    const drop = prompt("Enter Drop Location:");
    if (!drop) {
      alert("Drop location is required!");
      return;
    }

    const confirmBooking = confirm(
      `Passenger Name: ${passengerName}
Pickup Location: ${pickup}
Drop Location: ${drop}

Confirm Cab Booking?`
    );

    if (confirmBooking) {
      alert(
        `🚕 Cab Booked Successfully!

Passenger: ${passengerName}
Pickup: ${pickup}
Drop: ${drop}

Driver will arrive shortly.`
      );
    } else {
      alert("❌ Cab Booking Cancelled.");
    }
  };

  return (
    <div style={styles.container}>
      <h2>🚕 Online Cab Booking System</h2>

      <div style={styles.card}>
        <img
          src="https://cdn-icons-png.flaticon.com/512/854/854878.png"
          alt="Cab"
          style={styles.image}
        />

        <h3>Book Your Cab</h3>
        <p>Safe • Fast • Reliable</p>

        <button style={styles.button} onClick={bookCab}>
          Book Cab
        </button>
      </div>
    </div>
  );
}

const styles = {
  container: {
    fontFamily: "Segoe UI",
    textAlign: "center",
    marginTop: "50px",
  },
  card: {
    width: "330px",
