    border: "1px solid #ccc",
  },
  previewBox: {
    marginTop: "15px",
    padding: "10px",
    border: "1px dashed #888",
    borderRadius: "5px",
    backgroundColor: "#f9f9f9",
  },
  button: {
    marginTop: "15px",
    padding: "10px 22px",
    backgroundColor: "#3f51b5",
    color: "white",
    border: "none",
    borderRadius: "5px",
    cursor: "pointer",
  },
};

export default App;
